# API
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
API_BASE_URL=http://localhost:5001

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.example.com/campuspe

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# AI: OpenAI is used for resume extraction, job normalization, and tailoring
OPENAI_API_KEY=sk-proj-placeholder
OPENAI_RESUME_MODEL=gpt-4o-mini
OPENAI_JOB_NORMALIZATION_MODEL=gpt-4o-mini
OPENAI_APPLICATION_TAILORING_MODEL=gpt-4o-mini

# OpenAI throughput controls. Lower the concurrency or raise the interval if the
# key hits 429s during job synchronization.
OPENAI_MAX_CONCURRENCY=2
OPENAI_MIN_REQUEST_INTERVAL_MS=250

# Background job enrichment is optional; provider data is used when disabled.
AI_JOB_ENRICHMENT_ENABLED=true
AI_JOB_ENRICHMENT_MAX_PER_SYNC=50

# Embeddings: Cohere is used for job/resume matching vectors.
# Trial keys allow only 100 calls/minute; a production key is recommended.
COHERE_API_KEY=cohere-placeholder
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_MAX_CONCURRENCY=4
COHERE_MIN_REQUEST_INTERVAL_MS=150

# Caps embeddings minted inside a single user request. Jobs without a cached
# vector score on skill overlap and are embedded by the background sync.
MATCH_EMBEDDING_BUDGET_PER_REQUEST=12
MATCH_EMBEDDING_CONCURRENCY=4
BULK_AUTO_APPLY_EMBEDDING_BUDGET=25

# Queue: Upstash/Redis TLS URLs should use rediss://
REDIS_URL=rediss://default:password@redis-host.example.com:6379

# ATS adapters
GREENHOUSE_JOB_BOARD_API_KEY=replace-if-required
LEVER_POSTINGS_API_KEY=replace-if-authorized-by-employer
LEVER_API_REGION=global

# Consent enforcement. Enable after existing users have completed the
# purpose-specific consent migration.
ENFORCE_APPLICATION_CONSENT=false
CONSENT_AUDIT_SECRET=replace-with-a-separate-long-random-secret

# Storage / messaging
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_URL=
TWOFACTOR_API_KEY=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_EMAIL_FROM=
WABB_WEBHOOK_URL_OTP=
WABB_WEBHOOK_URL_JOBS=
WABB_WEBHOOK_URL_RESUME=
WABB_WEBHOOK_URL_GENERAL=
WABB_WEBHOOK_URL_FORGOT=
WABB_WEBHOOK_URL=
WABB_WEBHOOK_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PLAYWRIGHT_PDF_SERVICE_URL=
